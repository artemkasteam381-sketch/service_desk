# Добавьте эти строки в свой .env. Относительный путь считается от корня проекта.
CLASSIFICATION_MODEL_DIR=models/classification
CLASSIFICATION_DEVICE=cpu
CLASSIFICATION_BATCH_SIZE=16

# Варианты CLASSIFICATION_DEVICE: cpu, cuda, auto.
# Для сервера без интернета сначала загрузите RuBERT в локальный кеш,
# затем можно установить HF_HUB_OFFLINE=1.
